+        assert_identity(TurnMode::Execute, false).await
+    }
+    #[tokio::test]
+    async fn structured_execute_uses_reserved_turn_identity_in_actual_agent_context() -> Result<()>
+    {
+        assert_identity(TurnMode::Execute, true).await
+    }
